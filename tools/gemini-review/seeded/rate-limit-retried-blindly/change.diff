+func TestClientAsksAgainWhenOuraRateLimitsIt(t *testing.T) {
+	calls := 0
+	oura := &fakeOura{respond: func(*http.Request) (*http.Response, error) {
+		calls++
+		if calls == 1 {
+			return answer(http.StatusTooManyRequests, `{"detail": "Rate limit exceeded"}`), nil
+		}
+		return answer(http.StatusOK, `{"data": [{"day": "2026-11-01", "score": 82}], "next_token": null}`), nil
+	}}
+
+	documents, err := newTestClient(oura).DailySleep(t.Context(), mustDays(t, "2026-11-01", "2026-11-01"))
+
+	if err != nil || len(documents) != 1 || len(oura.requests) != 2 {
+		t.Errorf("documents = %+v, err = %v after %d requests; want one document after two", documents, err, len(oura.requests))
+	}
