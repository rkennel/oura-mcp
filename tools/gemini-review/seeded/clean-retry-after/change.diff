 )
@@ -59,6 +60,10 @@ type StatusError struct {
 	StatusCode int
 	// Detail is Oura's explanation, or the status text when it gave none.
 	Detail string
+	// RetryAfter is how long Oura asked the client to wait before trying
+	// again, from the Retry-After header of a 429, or zero when it asked
+	// for no particular wait.
+	RetryAfter time.Duration
 }
 
 func (e *StatusError) Error() string {
@@ -223,7 +228,23 @@ func statusError(collection string, response *http.Response) *StatusError {
 	if err := json.NewDecoder(io.LimitReader(response.Body, maxErrorBytes)).Decode(&body); err == nil && body.Detail != "" {
 		detail = body.Detail
 	}
-	return &StatusError{Collection: collection, StatusCode: response.StatusCode, Detail: detail}
+	return &StatusError{
+		Collection: collection,
+		StatusCode: response.StatusCode,
+		Detail:     detail,
+		RetryAfter: retryAfter(response.Header.Get("Retry-After")),
+	}
+}
+
+// retryAfter reads a Retry-After header given in whole seconds. Anything
+// else, the HTTP-date form included, reads as zero, so a caller reports the
+// limit rather than guess how long to wait.
+func retryAfter(header string) time.Duration {
+	seconds, err := strconv.Atoi(strings.TrimSpace(header))
+	if err != nil || seconds < 0 {
+		return 0
+	}
+	return time.Duration(seconds) * time.Second
 }
 
