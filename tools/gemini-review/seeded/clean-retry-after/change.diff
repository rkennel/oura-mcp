+func TestClientCarriesTheWaitOuraAsksForWhenRateLimited(t *testing.T) {
+	oura := &fakeOura{respond: func(*http.Request) (*http.Response, error) {
+		limited := answer(http.StatusTooManyRequests, `{"detail": "Rate limit exceeded"}`)
+		limited.Header.Set("Retry-After", "120")
+		return limited, nil
+	}}
+
+	_, err := newTestClient(oura).Sleep(t.Context(), mustDays(t, "2026-11-01", "2026-11-01"))
+
+	var statusErr *StatusError
+	if !errors.As(err, &statusErr) || statusErr.RetryAfter != 2*time.Minute {
+		t.Errorf("error = %v, want a *StatusError asking for a 2m0s wait", err)
+	}
+}
+
+func TestRetryAfterReadsOnlyWholeSeconds(t *testing.T) {
+	for header, want := range map[string]time.Duration{
+		"120":                           2 * time.Minute,
+		" 5 ":                           5 * time.Second,
+		"0":                             0,
+		"":                              0,
+		"-5":                            0,
+		"soon":                          0,
+		"Wed, 21 Oct 2026 07:28:00 GMT": 0,
+	} {
+		if got := retryAfter(header); got != want {
+			t.Errorf("retryAfter(%q) = %v, want %v", header, got, want)
+		}
+	}
+}
