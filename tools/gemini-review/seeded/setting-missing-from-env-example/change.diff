+func TestLoadConfigDefaultsTheLogLevelToInfo(t *testing.T) {
+	config, err := LoadConfig(validEnv(nil))
+	if err != nil {
+		t.Fatalf("LoadConfig: %v", err)
+	}
+	if config.LogLevel != slog.LevelInfo {
+		t.Errorf("LogLevel = %v, want INFO", config.LogLevel)
+	}
+}
+
+func TestLoadConfigReadsTheLogLevel(t *testing.T) {
+	config, err := LoadConfig(validEnv(map[string]string{logLevelVariable: "DEBUG"}))
+	if err != nil {
+		t.Fatalf("LoadConfig: %v", err)
+	}
+	if config.LogLevel != slog.LevelDebug {
+		t.Errorf("LogLevel = %v, want DEBUG", config.LogLevel)
+	}
+}
+
+func TestLoadConfigRejectsAnUnknownLogLevel(t *testing.T) {
+	_, err := LoadConfig(validEnv(map[string]string{logLevelVariable: "LOUD"}))
+	if !errors.Is(err, errLogLevel) {
+		t.Errorf("err = %v, want %v", err, errLogLevel)
+	}
+}
