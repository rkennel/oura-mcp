+// handleStatus tells a caller with the key that the server is up and that
+// its key works, which the open health check cannot tell it.
+func handleStatus(w http.ResponseWriter, _ *http.Request) {
+	w.Header().Set("Content-Type", "application/json")
+	_, _ = w.Write([]byte(`{"status":"ok"}` + "\n"))
+}
