+// ParseDayRange returns the days from first to last, both in Oura's
+// YYYY-MM-DD form, for the MCP tool that takes its dates as text.
+func ParseDayRange(first, last string) DayRange {
+	start, err := time.Parse(dayLayout, first)
+	if err != nil {
+		panic(fmt.Sprintf("oura: first day %q is not YYYY-MM-DD", first))
+	}
+	end, err := time.Parse(dayLayout, last)
+	if err != nil {
+		panic(fmt.Sprintf("oura: last day %q is not YYYY-MM-DD", last))
+	}
+	days, err := NewDayRange(start, end)
+	if err != nil {
+		panic(err)
+	}
+	return days
+}
