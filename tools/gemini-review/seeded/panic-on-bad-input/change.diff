+func TestParseDayRangeReadsOurasDayForm(t *testing.T) {
+	days := ParseDayRange("2026-11-01", "2026-11-03")
+
+	if got := days.Days(); !slices.Equal(got, []string{"2026-11-01", "2026-11-02", "2026-11-03"}) {
+		t.Errorf("days = %v", got)
+	}
+}
+
+func TestParseDayRangePanicsOnDaysItCannotUse(t *testing.T) {
+	for name, pair := range map[string][2]string{
+		"bad first": {"11/01/2026", "2026-11-03"},
+		"bad last":  {"2026-11-01", "soon"},
+		"reversed":  {"2026-11-03", "2026-11-01"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			defer func() {
+				if recover() == nil {
+					t.Error("ParseDayRange did not panic")
+				}
+			}()
+			ParseDayRange(pair[0], pair[1])
+		})
+	}
+}
