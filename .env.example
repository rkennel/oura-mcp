# Local settings for oura-mcp. To use them:
#
#   cp .env.example .env
#
# then edit .env. Git ignores .env, so never put a real key in this file.
# scripts/start-server.sh, scripts/run-server.sh and scripts/e2e-test.sh load
# .env; a variable already set in your shell wins over the value here.
#
# One KEY=value per line. Quotes around the value are optional. Lines that
# start with # are comments; text after a value is part of the value.

# The key every request except GET /health must send in its x-api-key
# header. Any value works locally; production reads it from Secret Manager.
CONNECTOR_API_KEY=change-me-local-dev-key

# The port the server listens on (default 8080).
PORT=8080

# Where the server reaches the Oura API (default https://api.ouraring.com).
# Leave it unset to use the real API; the end-to-end tests point it at the
# fake Oura API in e2e/fakeoura.
# OURA_API_BASE_URL=https://api.ouraring.com
