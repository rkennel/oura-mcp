{
  "models": {
    "triage": "gemini-3.5-flash-lite",
    "standard": "gemini-3.8-flash",
    "high_risk": "gemini-4-argon"
  },
  "high_risk_line_threshold": 400,
  "critical_paths": [
    {"pattern": ".github/workflows/**", "why": "CI and review workflows, which run with repository secrets"},
    {"pattern": ".github/gemini-review.json", "why": "these routing rules"},
    {"pattern": "tools/gemini-review/**", "why": "the review tool, which posts with a GitHub token"},
    {"pattern": "GEMINI.md", "why": "the review standards"},
    {"pattern": "cmd/server/**", "why": "the MCP server entry point"},
    {"pattern": "internal/app/config.go", "why": "reads the API key and other secrets from the environment"},
    {"pattern": "internal/httpapi/handler.go", "why": "the routes, and which of them need the API key"},
    {"pattern": "**/*auth*", "why": "authentication"},
    {"pattern": "**/*token*", "why": "token handling"},
    {"pattern": "**/*apikey*", "why": "API key handling"},
    {"pattern": "**/*secret*", "why": "secret handling"},
    {"pattern": "Dockerfile", "why": "the production image"},
    {"pattern": "scripts/deploy.sh", "why": "deploys to production and wires the API key secret"},
    {"pattern": "go.mod", "why": "dependencies"},
    {"pattern": "go.sum", "why": "dependencies"}
  ],
  "shared_packages": [
    "internal/**"
  ]
}
